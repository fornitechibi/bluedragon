---
import { advisoryHref, formatDate, type Advisory } from '../data/advisories';
import CvssDial from './CvssDial.astro';
import VectorGrid from './VectorGrid.astro';

interface Props {
  advisory: Advisory;
  headingLevel?: 'h2' | 'h3';
}

const { advisory: a, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const others = a.finders - 1;
const products = a.affected.length;
const families = [...new Set(a.affected.map((p) => (p.family === 'Other' ? '.NET MsQuic package' : p.family === 'Developer Tools' ? 'Visual Studio' : 'Windows')))];
---

<article class="panel spot adv" aria-labelledby={`${a.slug}-title`} data-spot>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <img src="/logos/microsoft.svg" alt="" width="18" height="18" class="mr-1 h-[18px] w-[18px]" />
      <span class="text-sm text-mute">Microsoft Security Response Center</span>
    </div>

    <p class="adv-id mt-4">{a.id}</p>
    <Heading id={`${a.slug}-title`} class="h-sub mt-1.5">{a.title}</Heading>
    <p class="mt-3 max-w-[60ch] text-[0.98rem] leading-relaxed text-fg/80">{a.description}</p>

    <div class="mt-4 flex flex-wrap gap-2">
      <span class="sev sev-important">{a.severity}</span>
      <span class="chip">{a.impact}</span>
      <a class="chip hover:border-frost/50" href={a.cwe.url} rel="noopener">
        <span class="mono text-frost">{a.cwe.id}</span>
        {a.cwe.name}
      </a>
    </div>

    <dl class="adv-facts mt-6">
      <div>
        <dt>Released</dt>
        <dd>{formatDate(a.released)}</dd>
      </div>
      <div>
        <dt>Exploitability</dt>
        <dd>{a.exploitability.assessment}</dd>
      </div>
      <div>
        <dt>Disclosed or exploited</dt>
        <dd>{a.exploitability.publiclyDisclosed ? 'Disclosed' : 'Not disclosed'}, {a.exploitability.exploited ? 'exploited' : 'not exploited'}</dd>
      </div>
      <div>
        <dt>Fixed in</dt>
        <dd>{products} products across {families.join(', ')}</dd>
      </div>
    </dl>

    <div class="mt-6">
      <VectorGrid vector={a.cvss.vector} />
    </div>

    <div class="ack mt-6">
      <img src="/bluedragon.jpg" alt="" width="64" height="64" />
      <p class="min-w-0">
        Acknowledged by Microsoft as <strong class="font-semibold text-fg">{a.creditedAs}</strong>
        <span class="text-mute">{others > 0 ? `, one of ${a.finders} independently credited finders` : ''}</span>
      </p>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn btn-primary" href={a.links.vendor} rel="noopener">
        Verify on MSRC
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <a class="btn btn-ghost" href={advisoryHref(a)}>Full advisory</a>
      {a.relatedWriteup && <a class="btn btn-ghost" href={a.relatedWriteup}>Read the writeup</a>}
      <a class="btn btn-ghost" href={a.links.cve} rel="noopener">CVE record</a>
    </div>
  </div>

  <aside class="flex flex-row items-center gap-6 border-line max-lg:border-t max-lg:pt-6 lg:flex-col lg:items-stretch lg:border-l lg:pl-8">
    <div class="flex flex-col items-center">
      <CvssDial score={a.cvss.base} />
      <p class="mt-1 text-xs text-mute">CVSS 3.1 base</p>
    </div>
    <div class="grid min-w-0 flex-1 content-start gap-3 text-sm lg:mt-6 lg:flex-none">
      <div class="flex items-baseline justify-between gap-3">
        <span class="text-mute">Temporal</span>
        <span class="text-base font-semibold tabular-nums">{a.cvss.temporal.toFixed(1)}</span>
      </div>
      <div class="flex items-baseline justify-between gap-3">
        <span class="text-mute">Product</span>
        <span class="text-right font-medium">{a.product}</span>
      </div>
      <div class="flex items-baseline justify-between gap-3">
        <span class="text-mute">CNA</span>
        <span class="font-medium">{a.cna}</span>
      </div>
      <p class="well mono mt-1 break-all px-3 py-2 text-[0.7rem] leading-relaxed text-frost/90">{a.cvss.vector}</p>
    </div>
  </aside>
</article>
