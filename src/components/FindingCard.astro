---
import { findingHref, type Severity } from '../data/findings';

interface Props {
  id: string;
  title: string;
  lede: string;
  severity: Severity;
  series: string;
  product: string;
  reach: string;
  component: string;
  logo?: string;
}

const { id, title, lede, severity, series, product, reach, component, logo } = Astro.props;
const href = findingHref(series, id);
const sevClass = { Critical: 'sev-crit', High: 'sev-high', Medium: 'sev-med', Low: 'sev-low' }[severity];
---

<a class="panel spot finding group" href={href} data-spot>
  <div class="flex items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-2.5">
      {logo && <img src={logo} alt="" width="18" height="18" class="h-[18px] w-[18px] object-contain" />}
      <span class="truncate text-sm font-medium text-mute">{product}</span>
    </div>
    <svg class="arrow h-4 w-4 flex-none text-frost" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </div>
  <h3 class="mt-4 text-[1.18rem] font-[680] leading-snug tracking-tight [font-stretch:105%] text-balance">{title}</h3>
  <p class="mt-2.5 text-[0.95rem] leading-relaxed text-fg/72">{lede}</p>
  <div class="meta">
    <span class:list={['sev', sevClass]}>{severity}</span>
    <span class="chip">{reach}</span>
    <span class="chip mono !text-[0.72rem] max-w-full truncate">{component}</span>
  </div>
</a>
