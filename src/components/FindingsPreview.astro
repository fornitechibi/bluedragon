---
import { getCollection } from 'astro:content';
import FindingCard from './FindingCard.astro';
import { severityRank, seriesMeta, type SeriesId } from '../data/findings';

const all = await getCollection('findings');
const featured = [...all]
  .sort((a, b) => {
    const bySev = severityRank[a.data.severity] - severityRank[b.data.severity];
    if (bySev !== 0) return bySev;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 5);
const targets = new Set(all.map((e) => e.data.product)).size;
---

<section id="findings" class="section wrap scroll-mt-24" aria-labelledby="findings-heading">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="section-head !mb-0">
      <p class="kicker">Public writeups</p>
      <h2 id="findings-heading" class="h-section">Findings, written up in full</h2>
      <p class="lede">
        {all.length} reports across {targets} open-source targets. Each one walks the bug, the code path, a diagram of the failure, the impact, and the fix.
      </p>
    </div>
    <a class="btn btn-ghost w-fit shrink-0" href="/findings">All {all.length} reports</a>
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      featured.map((entry, i) => (
        <div class:list={[i === 0 && 'lg:col-span-2']}>
          <FindingCard
            id={entry.id}
            title={entry.data.title}
            lede={entry.data.lede}
            severity={entry.data.severity}
            series={entry.data.series}
            product={entry.data.product}
            reach={entry.data.reach}
            component={entry.data.component}
            logo={seriesMeta[entry.data.series as SeriesId]?.logo}
          />
        </div>
      ))
    }
  </div>
</section>
