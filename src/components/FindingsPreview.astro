---
import { getCollection } from 'astro:content';
import FindingCard from './FindingCard.astro';
import { severityRank } from '../data/findings';

const all = await getCollection('findings');
const featured = [...all]
  .sort((a, b) => {
    const bySev = severityRank[a.data.severity] - severityRank[b.data.severity];
    if (bySev !== 0) return bySev;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 3);
---

<section id="findings" class="mx-auto max-w-6xl px-4 py-12 sm:px-6" aria-label="Public findings">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-2xl">
      <p class="section-kicker">Public writeups</p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Findings</h2>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-mute">
        Long-form reports from OSS hunts — starting with Microsoft MsQuic and Obyte. gVisor and selected audit writeups follow the same format as they are cleared to publish.
      </p>
    </div>
    <a class="neo-btn neo-btn-ghost w-fit shrink-0" href="/findings">All reports</a>
  </div>

  <div class="mt-8 grid gap-4 lg:grid-cols-3">
    {
      featured.map((entry) => (
        <FindingCard
          id={entry.id}
          title={entry.data.title}
          lede={entry.data.lede}
          severity={entry.data.severity}
          series={entry.data.series}
          product={entry.data.product}
          reach={entry.data.reach}
          component={entry.data.component}
        />
      ))
    }
  </div>
</section>
