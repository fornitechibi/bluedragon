---
import { profile } from '../data/profile';
---

<footer class="wrap pb-10 pt-4">
  <hr class="rule" />
  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 text-sm text-mute">
    <p>© {new Date().getFullYear()} {profile.name}. Published as {profile.handle}.</p>
    <nav class="flex flex-wrap gap-5" aria-label="Footer">
      <a class="hover:text-fg" href="/advisories">CVEs</a>
      <a class="hover:text-fg" href="/findings">Findings</a>
      <a class="hover:text-fg" href={profile.links.github} rel="noopener">GitHub</a>
      <a class="hover:text-fg" href={profile.links.x} rel="noopener">X</a>
    </nav>
  </div>
</footer>
