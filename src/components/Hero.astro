---
import { profile } from '../data/profile';
---

<section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-10 sm:px-6 lg:grid-cols-12 lg:py-16">
  <div class="min-w-0 lg:col-span-7">
    <p class="section-kicker mb-3">
      {profile.title} · {profile.credential}
    </p>
    <p class="text-sm font-medium text-mute">{profile.name}</p>
    <h1 class="hero-title mt-1 text-cream">{profile.handle}</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream/90">
      {profile.summary}
    </p>
    <p class="mt-4 max-w-xl text-base text-mute">
      {profile.findings} validated security findings. Full reports on Sherlock and Immunefi.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a class="neo-btn" href={profile.links.sherlock}>Sherlock profile</a>
      <a class="neo-btn neo-btn-ghost" href={profile.links.immunefi}>Immunefi profile</a>
      <a class="neo-btn neo-btn-ghost" href={`mailto:${profile.email}`}>Email</a>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-md min-w-0 lg:col-span-5">
    <div class="absolute -left-3 -top-3 z-10 bg-lime px-3 py-1 text-xs font-semibold text-ink shadow-[4px_4px_0_0_#f3ede0]">
      {profile.availability}
    </div>
    <figure class="portrait-frame">
      <img
        src="/bluedragon.jpg"
        alt="Bluedragon, cartoon portrait of a blue dragon wearing a hoodie"
        width="900"
        height="900"
        class="block w-full"
      />
    </figure>
    <p class="mt-4 text-sm text-mute">
      {profile.name} · {profile.handle}
    </p>
  </div>
</section>
