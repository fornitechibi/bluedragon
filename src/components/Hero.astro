---
import { profile } from '../data/profile';
import { advisories } from '../data/advisories';

const letters = [...profile.handle];
const ids = advisories.map((a) => a.id);
---

<section class="hero wrap" aria-labelledby="hero-title">
  <canvas class="heap" data-heap aria-hidden="true"></canvas>

  <div class="min-w-0">
    <a href="#advisories" class="credit-pill hero-rise" style="--d: 80ms">
      <span class="badge">
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="1" y="1" width="6.5" height="6.5" fill="#fff" opacity=".95"></rect><rect x="8.5" y="1" width="6.5" height="6.5" fill="#fff" opacity=".8"></rect><rect x="1" y="8.5" width="6.5" height="6.5" fill="#fff" opacity=".8"></rect><rect x="8.5" y="8.5" width="6.5" height="6.5" fill="#fff" opacity=".65"></rect></svg>
        MSRC
      </span>
      <span class="credit-text">
        <span>Credited by Microsoft for</span>
        {
          ids.map((id, i) => (
            <>
              {i > 0 && <span class="text-mute">and</span>}
              <span class="cve-tag mono">{id}</span>
            </>
          ))
        }
      </span>
    </a>

    <h1 id="hero-title" class="hero-title mt-7" aria-label={profile.handle}>
      {letters.map((ch, i) => <span class="ch" style={`--i:${i}`} aria-hidden="true">{ch}</span>)}
    </h1>

    <div class="mt-9 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <div class="hero-rise flex items-center gap-4" style="--d: 650ms">
          <div class="portrait">
            <img src="/bluedragon.jpg" alt="Bluedragon avatar: a blue dragon in a hoodie" width="136" height="136" />
          </div>
          <div class="min-w-0">
            <p class="text-lg font-[650] tracking-tight [font-stretch:108%]">{profile.name}</p>
            <p class="text-[0.95rem] text-mute">Security researcher and AI agentic engineer</p>
          </div>
        </div>
        <p class="lede hero-rise mt-6" style="--d: 760ms">
          I find memory-safety, protocol, and consensus bugs in the software that moves packets and money: QUIC stacks, sandboxes, crypto libraries, execution clients, and smart contracts.
        </p>
        <p class="lede hero-rise mt-3" style="--d: 820ms">
          I also build AI agents that run on their own: persistent memory, dependable tooling, and autonomous work that lasts more than 24 hours.
        </p>
      </div>

      <div class="hero-rise flex flex-col gap-5 lg:col-span-5 lg:items-end" style="--d: 880ms">
        <p class="inline-flex items-center gap-2.5 text-sm text-mute">
          <span class="live-dot" aria-hidden="true"></span>
          {profile.availability}
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="#advisories">Read the advisories</a>
          <a class="btn btn-ghost" href="/findings">Browse findings</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="../scripts/heap.ts"></script>
