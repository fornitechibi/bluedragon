---
import { languages, profile } from '../data/profile';

const groups = ['EVM', 'Distributed systems', 'Systems', 'Application'] as const;
---

<section id="languages" class="section wrap scroll-mt-24" aria-labelledby="languages-heading">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 id="languages-heading" class="h-sub">{profile.nsloc} nSLOC across contracts, chain internals, and OSS</h2>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-mute">
        Relative depth in the languages I read during review. The bars show focus, not a line count per language.
      </p>
    </div>
    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-8" data-reveal>
      {
        groups.map((group) => (
          <div>
            <p class="text-sm font-semibold text-frost">{group}</p>
            <ul class="mt-4 space-y-4">
              {languages
                .filter((lang) => lang.group === group)
                .map((lang, i) => (
                  <li>
                    <div class="mb-2 flex items-baseline justify-between gap-3">
                      <p>
                        <span class="font-semibold">{lang.name}</span>
                        <span class="ml-2 text-sm text-mute">{lang.domain}</span>
                      </p>
                      <span class="shrink-0 text-xs text-mute">{lang.label}</span>
                    </div>
                    <div class="lang-bar" role="img" aria-label={`${lang.name}: ${lang.label}`}>
                      <span style={`--w:${lang.depth / 100}; --i:${i}`} />
                    </div>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
