---
import { orgs } from '../data/profile';

const rowA = orgs.slice(0, 6);
const rowB = orgs.slice(6);
---

<section id="targets" class="wrap pb-6 scroll-mt-24" aria-labelledby="targets-heading">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
    <h2 id="targets-heading" class="h-sub">Validated findings in code from</h2>
    <p class="text-sm text-mute">{orgs.length} organizations and protocols</p>
  </div>

  <div class="mt-6 grid gap-3">
    {
      [rowA, rowB].map((row, r) => (
        <div class="marquee">
          <div class:list={['marquee-track', r === 1 && 'rev']}>
            <ul class="flex gap-3 pr-3" role="list">
              {row.map((org) => (
                <li class="logo-chip">
                  <img src={org.logo} alt="" width="24" height="24" />
                  <span>{org.name}</span>
                </li>
              ))}
            </ul>
            {[0, 1, 2].map(() => (
              <ul class="flex gap-3 pr-3" aria-hidden="true">
                {row.map((org) => (
                  <li class="logo-chip">
                    <img src={org.logo} alt="" width="24" height="24" />
                    <span>{org.name}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
