---
import { profile } from '../data/profile';

const path = Astro.url.pathname;
const isHome = path === '/' || path === '';
const at = (hash: string) => (isHome ? `#${hash}` : `/#${hash}`);

// Page order. Only the two links marked `phone` show on small screens.
const links = [
  { label: 'Experience', href: at('experience'), section: 'experience' },
  { label: 'CVEs', href: '/advisories', section: 'advisories', match: '/advisories', phone: true },
  { label: 'Findings', href: '/findings', section: 'findings', match: '/findings', phone: true },
  { label: 'Record', href: at('record'), section: 'record' },
  { label: 'Agents', href: at('agents'), section: 'agents' },
  { label: 'Contact', href: at('contact'), section: 'contact' },
];
---

<header class="site-header" data-header>
  <div class="wrap">
    <div class="nav-shell">
      <a href="/" class="flex items-center gap-2.5 rounded-full pr-2 no-underline" aria-label={`${profile.handle} home`}>
        <img src="/bluedragon.jpg" alt="" width="36" height="36" class="h-9 w-9 rounded-full border border-line-strong object-cover" />
        <span class="hidden text-[0.98rem] font-[680] tracking-tight [font-stretch:112%] sm:inline">{profile.handle}</span>
      </a>

      <nav class="nav-links" aria-label="Primary" data-nav>
        <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
        {
          links.map((l) => (
            <a
              href={l.href}
              data-section={isHome ? l.section : undefined}
              aria-current={l.match && path.startsWith(l.match) ? 'true' : undefined}
              class:list={[!l.phone && 'max-md:hidden']}
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <button
        type="button"
        class="btn btn-ghost !h-9 !px-3 text-sm"
        data-cmdk-open
        aria-label="Search findings and CVEs"
      >
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="9" r="5.5"></circle><path d="m13.5 13.5 3.5 3.5" stroke-linecap="round"></path></svg>
        <span class="kbd max-sm:hidden" data-kbd>⌘K</span>
      </button>
    </div>
  </div>
</header>
