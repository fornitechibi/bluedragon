---
import { roles } from '../data/profile';
---

<section id="experience" class="section wrap scroll-mt-24" aria-labelledby="experience-heading">
  <div class="section-head">
    <p class="kicker">Experience</p>
    <h2 id="experience-heading" class="h-section">Security research, triage, and agent engineering</h2>
    <p class="lede">
      Two years of audits and bug bounty, a triage seat at Cantina on more than 5,000 reports, and eight months engineering autonomous AI agents.
    </p>
  </div>

  <div class="panel grid overflow-hidden lg:grid-cols-3">
    {
      roles.map((role, i) => (
        <article class:list={['p-6 sm:p-7', i > 0 && 'border-line max-lg:border-t lg:border-l']}>
          <p class="text-sm font-medium text-frost">{role.period}</p>
          <h3 class="mt-2 text-lg font-[680] tracking-tight [font-stretch:105%]">{role.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-fg/75">{role.body}</p>
        </article>
      ))
    }
  </div>
</section>
