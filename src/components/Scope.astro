---
import { languages, profile, roles } from '../data/profile';

const groups = ['EVM', 'Distributed systems', 'Systems', 'Application'] as const;
---

<section id="experience" class="section wrap scroll-mt-24" aria-labelledby="experience-heading">
  <div class="section-head">
    <p class="kicker">Experience</p>
    <h2 id="experience-heading" class="h-section">Security research, triage, and agent engineering</h2>
    <p class="lede">
      Two years of audits and bug bounty, a triage seat at Cantina on more than 5,000 reports, and eight months engineering autonomous AI agents.
    </p>
  </div>

  <div class="panel grid overflow-hidden lg:grid-cols-3">
    {
      roles.map((role, i) => (
        <article class:list={['p-6 sm:p-7', i > 0 && 'border-line max-lg:border-t lg:border-l']}>
          <p class="text-sm font-medium text-frost">{role.period}</p>
          <h3 class="mt-2 text-lg font-[680] tracking-tight [font-stretch:105%]">{role.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-fg/75">{role.body}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-16 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h3 class="h-sub">{profile.nsloc} nSLOC across contracts, chain internals, and OSS</h3>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-mute">
        Relative depth in the languages I read during review. The bars show focus, not a line count per language.
      </p>
    </div>
    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-8" data-reveal>
      {
        groups.map((group) => (
          <div>
            <p class="text-sm font-semibold text-frost">{group}</p>
            <ul class="mt-4 space-y-4">
              {languages
                .filter((lang) => lang.group === group)
                .map((lang, i) => (
                  <li>
                    <div class="mb-2 flex items-baseline justify-between gap-3">
                      <p>
                        <span class="font-semibold">{lang.name}</span>
                        <span class="ml-2 text-sm text-mute">{lang.domain}</span>
                      </p>
                      <span class="shrink-0 text-xs text-mute">{lang.label}</span>
                    </div>
                    <div class="lang-bar" role="img" aria-label={`${lang.name}: ${lang.label}`}>
                      <span style={`--w:${lang.depth / 100}; --i:${i}`} />
                    </div>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
