---
import { languages, profile, roles } from '../data/profile';

const groups = ['EVM', 'Distributed systems', 'Systems', 'Application'] as const;
---

<section id="scope" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="mb-8 max-w-2xl">
    <p class="section-kicker">Experience</p>
    <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
      Research, triage, and AI systems
    </h2>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-mute">
      Two years in security research and bug bounty, a Cantina triage seat on 5,000+ reports, and eight months shipping production AI workflows.
    </p>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    {
      roles.map((role) => (
        <article class="neo p-5">
          <p class="text-xs font-semibold text-cyan">{role.period}</p>
          <h3 class="mt-2 text-lg font-semibold tracking-tight">{role.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream/85">{role.body}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-12 max-w-2xl">
    <p class="section-kicker">Stacks</p>
    <h3 class="mt-2 text-2xl font-semibold tracking-tight">
      {profile.nsloc} nSLOC across contracts, chain internals, and OSS
    </h3>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-mute">
      Relative depth in the languages I actually read in review. Bars show focus, not a line-count claim per language.
    </p>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    {
      groups.map((group) => (
        <article class="neo p-5">
          <h3 class="text-sm font-semibold text-cyan">{group}</h3>
          <ul class="mt-4 space-y-4">
            {languages
              .filter((lang) => lang.group === group)
              .map((lang) => (
                <li>
                  <div class="mb-1.5 flex items-baseline justify-between gap-3">
                    <div>
                      <p class="font-semibold">{lang.name}</p>
                      <p class="text-xs text-mute">{lang.domain}</p>
                    </div>
                    <span class="shrink-0 text-xs font-medium text-cyan">{lang.label}</span>
                  </div>
                  <div class="lang-bar" role="img" aria-label={`${lang.name} ${lang.label}`}>
                    <span style={`width: ${lang.depth}%`}></span>
                  </div>
                </li>
              ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
