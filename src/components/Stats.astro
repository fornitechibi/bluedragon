---
import { profile, stats } from '../data/profile';
import { advisories } from '../data/advisories';

const tiles = [
  { label: 'Microsoft CVEs credited', value: advisories.length, suffix: '', note: 'MsQuic, October 2026' },
  { label: 'Validated findings', value: 100, suffix: '+', note: 'Contests, live programs, OSS' },
  { label: 'Reports triaged', value: 5000, suffix: '+', note: 'At Cantina' },
  { label: 'nSLOC reviewed', value: 100, suffix: 'k+', note: 'EVM, DLT internals, OSS' },
];

const fmt = (n: number) => n.toLocaleString('en-US');
---

<section class="wrap" aria-label="Headline numbers">
  <div class="panel grid grid-cols-2 overflow-hidden lg:grid-cols-4" data-reveal>
    {
      tiles.map((t, i) => (
        <div class:list={['stat border-line', i % 2 === 1 && 'border-l border-line', i >= 2 && 'max-lg:border-t max-lg:border-line', i === 2 && 'lg:border-l']}>
          <p class="stat-num">
            <span class="odo" data-odo={t.value} data-suffix={t.suffix} aria-label={`${fmt(t.value)}${t.suffix}`}>
              {fmt(t.value)}
              {t.suffix}
            </span>
          </p>
          <p class="mt-3 font-semibold">{t.label}</p>
          <p class="mt-0.5 text-sm text-mute">{t.note}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-4 grid gap-4 md:grid-cols-2">
    <a class="panel spot group flex items-center justify-between gap-4 px-6 py-5 no-underline" href={profile.links.sherlock} rel="noopener" data-spot>
      <div>
        <p class="text-sm text-mute">Sherlock all-time</p>
        <p class="mt-1 text-2xl font-[720] tracking-tight [font-stretch:110%]">#{stats.sherlockRank}</p>
        <p class="mt-1 text-sm text-mute">Top 10 in {stats.top10} contests, top 25 in {stats.top25}</p>
      </div>
      <svg class="h-5 w-5 text-mute transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-frost" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
    <a class="panel spot group flex items-center justify-between gap-4 px-6 py-5 no-underline" href={profile.links.immunefi} rel="noopener" data-spot>
      <div>
        <p class="text-sm text-mute">Immunefi all-time</p>
        <p class="mt-1 text-2xl font-[720] tracking-tight [font-stretch:110%]">#{stats.immunefiRank}</p>
        <p class="mt-1 text-sm text-mute">Audit competitions and live bounty programs</p>
      </div>
      <svg class="h-5 w-5 text-mute transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-frost" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>
</section>
