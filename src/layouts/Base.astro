---
import '../styles/global.css';
import { profile } from '../data/profile';
import { advisories } from '../data/advisories';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  progress?: boolean;
}

const cveList = advisories.map((a) => a.id).join(' and ');

const {
  title = `${profile.handle} | ${profile.name}, security researcher and AI agentic engineer`,
  description = `${profile.name} (${profile.handle}), security researcher and AI agentic engineer, credited by Microsoft for ${cveList}. ${profile.findings} validated findings, ${profile.triaged} reports triaged at Cantina, ${profile.nsloc} nSLOC reviewed. Builds autonomous agents with persistent memory.`,
  progress = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#040812" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:site" content="@shibi_kishore" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      alternateName: profile.handle,
      jobTitle: profile.title,
      email: `mailto:${profile.email}`,
      url: Astro.site?.href,
      sameAs: [profile.links.x, profile.links.github, profile.links.sherlock, profile.links.immunefi],
      description,
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {progress && <div class="scroll-progress" data-progress aria-hidden="true"></div>}
    <slot />
    <CommandPalette />
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
