---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.handle} — ${profile.name} | Security Researcher`,
  description = `${profile.name}, ${profile.handle}. Independent security researcher and ex-Cantina triager. ${profile.findings} findings, ${profile.triaged} reports triaged, ${profile.nsloc} nSLOC. Also builds AI harnesses and agentic systems.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#07090F" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:site" content="@shibi_kishore" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      alternateName: profile.handle,
      jobTitle: profile.title,
      email: `mailto:${profile.email}`,
      url: Astro.site?.href,
      sameAs: [profile.links.x, profile.links.github, profile.links.sherlock, profile.links.immunefi],
      description,
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
