---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Bluedragon" description="This page does not exist.">
  <main id="main" class="wrap flex min-h-svh flex-col justify-center">
    <p class="mono text-sm text-frost">SIGSEGV at 0x00000404</p>
    <h1 class="display mt-4 text-[clamp(4rem,16vw,10rem)]">404</h1>
    <p class="lede mt-4">Nothing is mapped at this address. Start from the homepage, or jump straight to the advisories and findings.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">Go to the homepage</a>
      <a class="btn btn-ghost" href="/advisories">Credited CVEs</a>
      <a class="btn btn-ghost" href="/findings">Findings</a>
    </div>
  </main>
</Base>
