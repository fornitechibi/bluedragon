---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { profile } from '../../../data/profile';
import { findingHref, seriesMeta, severityRank, type SeriesId } from '../../../data/findings';

export async function getStaticPaths() {
  const entries = await getCollection('findings');
  return entries.map((entry) => {
    const parts = entry.id.split('/');
    const series = parts[0];
    const slug = parts.slice(1).join('/') || parts[0];
    return {
      params: { series, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const series = data.series as SeriesId;
const meta = seriesMeta[series];
const siblings = (await getCollection('findings'))
  .filter((item) => item.data.series === series)
  .sort((a, b) => {
    const bySev = severityRank[a.data.severity] - severityRank[b.data.severity];
    if (bySev !== 0) return bySev;
    return a.data.title.localeCompare(b.data.title);
  });
const index = siblings.findIndex((item) => item.id === entry.id);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;
const commitShort = data.commit ? data.commit.slice(0, 12) : undefined;
const sevClass = { Critical: 'sev-crit', High: 'sev-high', Medium: 'sev-med', Low: 'sev-low' }[data.severity];
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={`${data.title} | ${profile.handle}`} description={data.lede} progress>
  <Nav />
  <main id="main" class="wrap pb-24 pt-12 sm:pt-16">
    <p class="text-sm text-mute">
      <a class="link" href="/findings">Findings</a>
      <span class="px-1.5 opacity-40">/</span>
      <a class="link" href={`/findings#${series}`}>{meta.product}</a>
    </p>

    <header class="mt-6 max-w-4xl">
      <div class="flex flex-wrap items-center gap-2">
        <span class:list={['sev', sevClass]}>{data.severity}</span>
        <span class="chip">{data.reach}</span>
        {data.tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
      </div>
      <h1 class="display mt-5 text-[clamp(2rem,5vw,3.6rem)] !leading-[1.04] break-words">{data.title}</h1>
      <p class="lede mt-5">{data.lede}</p>
    </header>

    <dl class="report-meta mt-10 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <dt>Target</dt>
        <dd class="flex items-center gap-2">
          {meta.logo && <img src={meta.logo} alt="" width="18" height="18" class="h-[18px] w-[18px] object-contain" />}
          {data.target} {data.product}
        </dd>
      </div>
      <div>
        <dt>Component</dt>
        <dd class="mono break-words text-[0.84rem]">{data.component}</dd>
      </div>
      <div>
        <dt>Reach</dt>
        <dd>{data.reach}</dd>
      </div>
      <div>
        <dt>Revision</dt>
        <dd class="mono text-[0.84rem]">{commitShort ?? 'n/a'}</dd>
      </div>
    </dl>

    <div class="mt-14 grid gap-12 lg:grid-cols-12">
      {
        toc.length > 0 && (
          <aside class="hidden lg:col-span-3 lg:block">
            <nav class="rail" aria-label="On this page" data-rail>
              <span class="rail-thumb" data-rail-thumb aria-hidden="true" />
              <p class="mb-2 text-xs text-mute">On this page</p>
              {toc.map((h) => (
                <a href={`#${h.slug}`} data-rail-link={h.slug}>
                  {h.text}
                </a>
              ))}
            </nav>
          </aside>
        )
      }
      <article class:list={['report min-w-0', toc.length > 0 ? 'lg:col-span-9' : 'lg:col-span-12']}>
        <Content />
      </article>
    </div>

    <nav class="mt-20 grid gap-4 sm:grid-cols-2" aria-label="More in this series">
      {
        prev ? (
          <a class="panel spot finding" href={findingHref(prev.data.series, prev.id)} data-spot>
            <span class="text-sm text-mute">Previous in {meta.product}</span>
            <span class="mt-2 font-semibold leading-snug">{prev.data.title}</span>
          </a>
        ) : (
          <div class="max-sm:hidden" />
        )
      }
      {
        next && (
          <a class="panel spot finding sm:text-right" href={findingHref(next.data.series, next.id)} data-spot>
            <span class="text-sm text-mute">Next in {meta.product}</span>
            <span class="mt-2 font-semibold leading-snug">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </main>
  <Footer />
  <script src="../../../scripts/mermaid.ts"></script>
</Base>
