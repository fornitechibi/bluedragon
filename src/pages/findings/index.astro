---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FindingCard from '../../components/FindingCard.astro';
import { profile } from '../../data/profile';
import { advisories } from '../../data/advisories';
import { seriesMeta, seriesOrder, severityRank } from '../../data/findings';

const entries = await getCollection('findings');
const bySeries = Object.fromEntries(
  seriesOrder.map((id) => [id, entries.filter((entry) => entry.data.series === id)]),
) as Record<(typeof seriesOrder)[number], typeof entries>;

const count = (s: string) => entries.filter((e) => e.data.severity === s).length;
const populated = seriesOrder.filter((id) => bySeries[id].length > 0);
const reserved = seriesOrder.filter((id) => bySeries[id].length === 0);
---

<Base
  title={`Findings | ${profile.handle}`}
  description={`Public security writeups by ${profile.name}. ${entries.length} reports with architecture diagrams, attack paths, impact, and fixes.`}
>
  <Nav />
  <main id="main" class="wrap pb-24 pt-14 sm:pt-20">
    <div class="section-head">
      <p class="kicker">Public writeups</p>
      <h1 class="display text-[clamp(2.6rem,7vw,5rem)]">Findings</h1>
      <p class="lede">
        Readable technical notes from independent research: the bug, the code path, a diagram of the failure, the impact, and the fix. Vendor-credited CVEs are on <a class="link" href="/advisories">their own page</a>; contest records stay on
        <a class="link" href={profile.links.sherlock} rel="noopener">Sherlock</a> and <a class="link" href={profile.links.immunefi} rel="noopener">Immunefi</a>.
      </p>
    </div>

    <dl class="report-meta grid-cols-2 sm:grid-cols-5">
      <div><dt>Reports</dt><dd class="text-2xl">{entries.length}</dd></div>
      <div><dt>Credited CVEs</dt><dd class="text-2xl"><a class="hover:text-frost" href="/advisories">{advisories.length}</a></dd></div>
      <div><dt>Critical</dt><dd class="text-2xl">{count('Critical')}</dd></div>
      <div><dt>High</dt><dd class="text-2xl">{count('High')}</dd></div>
      <div><dt>Medium</dt><dd class="text-2xl">{count('Medium')}</dd></div>
    </dl>

    <nav class="mt-8 flex flex-wrap gap-2" aria-label="Jump to target">
      {
        populated.map((id) => (
          <a class="chip hover:border-frost/50 hover:text-fg" href={`#${id}`}>
            {seriesMeta[id].logo && <img src={seriesMeta[id].logo} alt="" width="14" height="14" class="h-3.5 w-3.5" />}
            {seriesMeta[id].product}
            <span class="opacity-60">{bySeries[id].length}</span>
          </a>
        ))
      }
    </nav>

    {
      populated.map((id) => {
        const meta = seriesMeta[id];
        const sorted = [...bySeries[id]].sort((a, b) => {
          const bySev = severityRank[a.data.severity] - severityRank[b.data.severity];
          if (bySev !== 0) return bySev;
          return a.data.title.localeCompare(b.data.title);
        });
        return (
          <section class="mt-20 scroll-mt-24" id={id} aria-labelledby={`${id}-heading`}>
            <div class="flex flex-wrap items-end justify-between gap-4 pb-6">
              <div class="flex min-w-0 items-start gap-4">
                {meta.logo && (
                  <span class="well grid h-12 w-12 flex-none place-items-center">
                    <img src={meta.logo} alt="" width="26" height="26" class="h-[26px] w-[26px] object-contain" />
                  </span>
                )}
                <div class="min-w-0">
                  <p class="text-sm text-mute">{meta.label}</p>
                  <h2 id={`${id}-heading`} class="h-sub mt-0.5">{meta.product}</h2>
                  <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-mute">{meta.blurb}</p>
                </div>
              </div>
              <p class="text-sm text-mute">{sorted.length} report{sorted.length === 1 ? '' : 's'}</p>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              {sorted.map((entry) => (
                <FindingCard
                  id={entry.id}
                  title={entry.data.title}
                  lede={entry.data.lede}
                  severity={entry.data.severity}
                  series={entry.data.series}
                  product={entry.data.product}
                  reach={entry.data.reach}
                  component={entry.data.component}
                  logo={meta.logo}
                />
              ))}
            </div>
          </section>
        );
      })
    }

    {
      reserved.length > 0 && (
        <section class="panel mt-20 p-6 sm:p-8">
          <h2 class="h-sub">Contest and private-review writeups</h2>
          <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-mute">
            {reserved.map((id) => seriesMeta[id].blurb).join(' ')}
          </p>
        </section>
      )
    }
  </main>
  <Footer />
</Base>
