---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Advisories from '../components/Advisories.astro';
import FindingsPreview from '../components/FindingsPreview.astro';
import Marquee from '../components/Marquee.astro';
import TrackRecord from '../components/TrackRecord.astro';
import Agents from '../components/Agents.astro';
import Scope from '../components/Scope.astro';
import Languages from '../components/Languages.astro';
import Contact from '../components/Contact.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Stats />
    <Scope />
    <Advisories />
    <Marquee />
    <FindingsPreview />
    <TrackRecord />
    <Agents />
    <Languages />
    <Contact />
